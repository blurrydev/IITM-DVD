# Folder holding the raw CSVs. Leave unset to auto-detect: ../data/raw (this repo's
# layout, see data/raw/readme.md), then ../data, then ../Project Dataset.
# DATA_DIR=../data/raw

# Where the enriched tables are pickled (defaults to backend/cache)
CACHE_DIR=cache

# Build tables at startup (true) or on the first request (false)
EAGER_LOAD=true

# Browsers allowed to call the API
CORS_ORIGINS=http://localhost:3000,https://dvd-project-fawn.vercel.app

# Set to enable POST /api/admin/refresh (sent as the X-Admin-Token header)
# ADMIN_TOKEN=change-me
